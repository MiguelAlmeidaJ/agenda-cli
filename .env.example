APP_NAME="Agenda CLI"
APP_ENV=production
APP_URL=https://seu-dominio.com.br
APP_TIMEZONE=America/Sao_Paulo

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=agenda
DB_USERNAME=agenda
DB_PASSWORD=troque-esta-senha

# Evolution GO
# A URL é fornecida pelo serviço/servidor Evolution GO.
# O token não fica neste arquivo: mantenha-o em um arquivo protegido fora de public/.
EVOLUTION_GO_BASE_URL=https://api.seu-provedor.com
EVOLUTION_GO_HEADER_FILE=/home/usuario/.agenda-cli/evolution-go.headers
