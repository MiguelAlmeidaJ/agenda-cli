APP_NAME="Agenda CLI"
APP_ENV=production
APP_URL=https://seu-dominio.com.br
APP_TIMEZONE=America/Sao_Paulo

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=agenda
DB_USERNAME=agenda
DB_PASSWORD=troque-esta-senha

# Cloudinary - mantenha a API Secret apenas no ambiente do servidor.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Geocodificação do endereço do estabelecimento.
# O padrão usa Nominatim/OpenStreetMap. Identifique claramente a aplicação.
GEOCODING_BASE_URL=https://nominatim.openstreetmap.org
GEOCODING_USER_AGENT="AgendaCLI/1.0 (+https://seu-dominio.com.br)"

# Tiles do mapa público. Pode ser trocado futuramente sem alteração de código.
MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# Preparação para integração futura de WhatsApp.
# Mantenha tokens e chaves somente no ambiente do servidor.
WHATSAPP_PROVIDER=manual
WHATSAPP_API_URL=
WHATSAPP_TOKEN=
